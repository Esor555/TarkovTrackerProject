@page
@model IndexModel
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Http
@using System.Security.Claims
@using TarkovTrackerBLL.Service
@{
	ViewData["Title"] = "Tarkov Tracker";
	if (User.Identity.IsAuthenticated) Layout = "_LoggedInLayout";
	else Layout = "_Layout";
	var user = User;
	ViewData["role"] = user.IsInRole("admin") ? "admin" : "user";
	ViewData["playerdata"] = user.Identity.IsAuthenticated ? user.Identity.Name : "Guest";
}

<div class="container">
	<div class="header">
		<h1>TARKOV TRACKER</h1>
		<p>Your tactical companion for mastering Escape from Tarkov</p>
	</div>

	@if (User.Identity.IsAuthenticated)
	{
		<div class="welcome-section">
			<h2>Welcome, @User.Identity.Name</h2>
			<div class="button-group">
				<a asp-page="/User/Hideout" class="btn btn-primary">
					<i class="fas fa-tools"></i> Hideout
				</a>
				<a asp-page="/User/Quest" class="btn btn-success">
					<i class="fas fa-scroll"></i> Quests
				</a>
			</div>
		</div>

	}
	else
	{
		<div class="welcome-section">
			<h2>Ready to Begin Your Journey?</h2>
			<p>Join TarkovTracker to start tracking your progress in Escape from Tarkov</p>
			<div class="button-group">
				<a asp-page="/Login" class="btn btn-primary">
					<i class="fas fa-sign-in-alt"></i> Login
				</a>
				<a asp-page="/Register" class="btn btn-success">
					<i class="fas fa-user-plus"></i> Register
				</a>
			</div>
		</div>

		<div class="features">
			<div class="feature-card">
				<h3><i class="fas fa-tools"></i> Hideout Tracking</h3>
				<p>Track your hideout upgrades and manage your stations</p>
			</div>

			<div class="feature-card">
				<h3><i class="fas fa-scroll"></i> Quest Progress</h3>
				<p>Track your quest completion and progress</p>
			</div>
		</div>
	}
</div>

<style>
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 20px;
	}

	.header {
		text-align: center;
		margin-bottom: 40px;
	}

	.header h1 {
		font-size: 2.5rem;
		margin-bottom: 10px;
	}

	.welcome-section {
		text-align: center;
		margin-bottom: 40px;
		padding: 20px;
		background-color: var(--camo-medium);
		border: 1px solid var(--camo-border);
		border-radius: 4px;
	}

	.button-group {
		margin-top: 20px;
	}

	.button-group a {
		margin: 0 10px;
	}

	.features {
		display: flex;
		gap: 20px;
		justify-content: center;
		flex-wrap: wrap;
	}

	.feature-card {
		flex: 1;
		min-width: 300px;
		max-width: 400px;
		padding: 20px;
		background-color: var(--camo-medium);
		border: 1px solid var(--camo-border);
		border-radius: 4px;
	}

	.feature-card h3 {
		margin-bottom: 15px;
	}

	.feature-card p {
		margin-bottom: 20px;
		color: var(--camo-text);
	}

	.btn {
		display: inline-block;
		padding: 10px 20px;
		text-decoration: none;
		border-radius: 4px;
		font-weight: 500;
		transition: all 0.2s ease;
	}

	.btn i {
		margin-right: 5px;
	}
</style>